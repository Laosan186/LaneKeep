#!/bin/sh /etc/rc.common
# First creation. Runtime-only isolated PC candidate; boot remains disabled.
START=95
STOP=10
USE_PROCD=1

start_service() {
    [ "$(uci -q get lanekeep_runtime.main.enabled)" = 1 ] || return 0
    nft list table inet lanekeep_dns_gate >/dev/null 2>&1 || return 1
    procd_open_instance core
    procd_set_param command /usr/libexec/lanekeep-xray/xray-gated-start.sh
    procd_set_param limits core="0" nofile="16384 16384"
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_set_param file /etc/lanekeep-proxy/config.json /usr/libexec/lanekeep-xray/xray-gated-start.sh
    procd_close_instance

    procd_open_instance dns_gate
    procd_set_param command /usr/libexec/lanekeep-xray/dns-gate-watchdog.sh
    procd_set_param limits core="0"
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_set_param file /usr/libexec/lanekeep-xray/dns-gate-watchdog.sh /usr/libexec/lanekeep-xray/dns-gate-probe.sh
    procd_close_instance
}

stop_service() {
    nft flush set inet lanekeep_dns_gate healthy_data >/dev/null 2>&1 || :
}
