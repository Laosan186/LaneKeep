#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-only
USE_PROCD=1
START=95
STOP=10
start_service() {
    [ "$(uci -q get lanekeep_runtime.main.enabled)" = 1 ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/xray run -config /etc/lanekeep-proxy/domestic-dns.json
    procd_set_param respawn
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
