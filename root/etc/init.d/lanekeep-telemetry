#!/bin/sh /etc/rc.common
START=96
STOP=9
USE_PROCD=1
start_service() {
    [ "$(uci -q get lanekeep_runtime.main.enabled)" = 1 ] || return 0
    awk '$2=="/tmp" && $3=="tmpfs" {ok=1} END {exit !ok}' /proc/mounts || return 1
    procd_open_instance collector
    procd_set_param command /usr/bin/ucode /usr/libexec/lanekeep-sampler-supervisor/supervise.uc
    procd_set_param respawn 3600 60 0
    procd_set_param term_timeout 10
    procd_set_param limits core="0"
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_set_param nice 10
    procd_close_instance
}
