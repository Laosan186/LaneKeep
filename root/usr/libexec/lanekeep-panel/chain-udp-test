#!/bin/sh
# One bounded chain step. Fixed owned directory; no core output or credentials in logs.
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
work=${1:-}; port=${2:-}
case "$work" in /tmp/lanekeep-panel/????????-????-????-????-????????????) ;; *) exit 64 ;; esac
case "$port" in ''|*[!0-9]*) exit 64 ;; esac
[ "$port" -ge 20000 ] && [ "$port" -lt 50000 ] || exit 64
[ -d "$work" ] && [ ! -L "$work" ] && [ -f "$work/test-config.json" ] && [ ! -L "$work/test-config.json" ] || exit 64
[ -f "$work/.owner" ] && [ ! -L "$work/.owner" ] && [ "$(cat "$work/.owner")" = lanekeep-chain-udp-test-v1 ] || exit 64
code=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
runner=
cleanup() {
 trap - EXIT HUP INT TERM
 if [ -n "$runner" ]; then
  kill -TERM -- "-$runner" 2>/dev/null || :
  ucode -e 'sleep(100);' 2>/dev/null || :
  kill -KILL -- "-$runner" 2>/dev/null || :
  wait "$runner" 2>/dev/null || :
 fi
 if [ -f "$work/.owner" ] && [ ! -L "$work/.owner" ] && [ "$(cat "$work/.owner")" = lanekeep-chain-udp-test-v1 ]; then
  for name in test-config.json test-config.json.next test-targets.json test-targets.json.next test-start test-result test-result.next; do
   if [ -f "$work/$name" ] && [ ! -L "$work/$name" ]; then rm -f -- "$work/$name"; fi
  done
  rm -f -- "$work/.owner"
  rmdir -- "$work" 2>/dev/null || :
 fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
setsid /bin/sh -c '
 exec 8>&-
 export XRAY_LOCATION_ASSET=/usr/share/v2ray
 /usr/bin/xray run -c "$1/test-config.json" >/dev/null 2>&1 &
 core=$!
 trap '\''kill "$core" 2>/dev/null || :'\'' EXIT
 sleep 1
 kill -0 "$core" 2>/dev/null || exit 1
 ucode "$2/chain-udp-wire.uc" "$1" "$3"
' lanekeep-chain "$work" "$code" "$port" >/dev/null 2>&1 &
runner=$!
tries=0
while [ "$tries" -lt 110 ]; do
 if [ -f "$work/test-result" ] && [ ! -L "$work/test-result" ]; then
  cat "$work/test-result"
  exit 0
 fi
 if ! kill -0 "$runner" 2>/dev/null; then
  printf '%s\n' '{"ok":false,"status":"failed","message":"临时测试进程未能完成请求；未尝试直连"}'
  exit 0
 fi
 ucode -e 'sleep(100);'
 tries=$((tries+1))
done
if [ -f "$work/test-start" ]; then
 printf '%s\n' '{"ok":false,"status":"timeout","message":"超时"}'
else
 printf '%s\n' '{"ok":false,"status":"failed","message":"临时测试进程启动失败"}'
fi
